POSTGRES_DB=izvor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Local JWT signing key — overrides the dev default baked into appsettings.json (must be 32+ chars)
JWT_SECRET=change-me-to-a-local-32-plus-char-secret-0123456789
# Must match the izvor_app role password created in db/clean/00_init.sql
IZVOR_DB_PASSWORD=izvor_app_dev
